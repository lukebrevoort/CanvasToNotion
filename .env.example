# Canvas (sit.instructure.com)
CANVAS_DOMAIN=sit.instructure.com

# Notion integration token (https://www.notion.so/my-integrations)
NOTION_TOKEN=

# Page ID where "Canvas HQ" (databases) will be created by `npm run setup`
# From the page URL: notion.so/<page-id>
NOTION_HQ_PAGE_ID=

# Optional: override database IDs after setup (auto-saved to data/state.json otherwise)
# NOTION_ASSIGNMENTS_DB_ID=
# NOTION_COURSES_DB_ID=

# Sync cadence in minutes (used by launchd deploy template)
SYNC_INTERVAL_MINUTES=10
